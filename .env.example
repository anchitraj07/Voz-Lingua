# Copy to .env (never commit .env). Real environment variables override this file.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# First admin – created on startup if this email does not exist yet.
# Use a long, unique passphrase (10+ chars, letters + numbers, must not contain the email name).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Production behind HTTPS reverse proxy (nginx / Caddy / Cloudflare):
# TRUST_PROXY=1            # only if the proxy sets X-Forwarded-For
# ALLOWED_ORIGINS=https://vozlingua.com,https://www.vozlingua.com
# DB_PATH=/var/lib/voz-lingua/voz-lingua.db

# Business rules
REQUIRE_APPROVAL=1         # 1 = admin must approve a plan before the student can book (use until payments exist)
CANCEL_HOURS=12            # students can cancel up to N hours before class
SEED_SAMPLE_DATA=1         # 1 = create sample batches/slots on first run (edit or close them in Admin)
